{
  "name": "spritematex-visual-studio-code-plugin",
  "displayName": "SpritemateX (Visual Studio Code Plugin)",
  "description": "A VS Code plugin that runs SpritemateX — the Commander X16 sprite & tile editor by OldSkoolCoder (OSK) — inside a VS Code webview.",
  "version": "1.0.1",
  "publisher": "MennoHomanWindigo",
  "author": "Menno Homan (Windigo)",
  "license": "MIT",
  "icon": "images/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/Windigo/spritematex-vsc-plugin"
  },
  "bugs": {
    "url": "https://github.com/Windigo/spritematex-vsc-plugin/issues"
  },
  "homepage": "https://github.com/Windigo/spritematex-vsc-plugin#readme",
  "keywords": [
    "sprite",
    "tile",
    "commander-x16",
    "x16",
    "retro",
    "pixel-art",
    "spritematex",
    "8-bit",
    "oldskoolcoder",
    "oldskool-coder",
    "oldskool coder",
    "osk"
  ],
  "galleryBanner": {
    "color": "#1a1a2e",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:spritematex.open"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "spritematex.open",
        "title": "SpritemateX: Open Editor",
        "category": "SpritemateX"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "spritematex.open"
        }
      ]
    },
    "keybindings": [
      {
        "command": "spritematex.open",
        "key": "ctrl+alt+x",
        "mac": "cmd+alt+x"
      }
    ]
  },
  "scripts": {
    "package": "vsce package",
    "publish": "vsce publish"
  },
  "devDependencies": {
    "@vscode/vsce": "^2.24.0"
  }
}
