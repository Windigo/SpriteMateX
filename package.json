{
  "name": "spritematex-vsc-plugin",
  "displayName": "SpritemateX (VS Code Plugin)",
  "description": "A VS Code plugin that runs SpritemateX — the Commander X16 sprite & tile editor by OldSkoolCoder (OSK) — inside a VS Code custom editor.",
  "version": "1.0.0",
  "publisher": "MennoHomanWindigo",
  "author": "Menno Homan (Windigo)",
  "license": "MIT",
  "icon": "images/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/Windigo/spritematex-vsc-plugin"
  },
  "bugs": {
    "url": "https://github.com/Windigo/spritematex-vsc-plugin/issues"
  },
  "homepage": "https://github.com/Windigo/spritematex-vsc-plugin#readme",
  "keywords": [
    "sprite",
    "tile",
    "commander-x16",
    "x16",
    "retro",
    "pixel-art",
    "spritematex",
    "8-bit",
    "oldskoolcoder",
    "oldskool-coder",
    "oldskool coder",
    "osk"
  ],
  "galleryBanner": {
    "color": "#1a1a2e",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCustomEditor:spritematex.spriteEditor",
    "onCommand:spritematex.newSprite"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "customEditors": [
      {
        "viewType": "spritematex.spriteEditor",
        "displayName": "SpritemateX Sprite Editor",
        "selector": [
          {
            "filenamePattern": "*.spmx"
          }
        ],
        "priority": "default"
      }
    ],
    "commands": [
      {
        "command": "spritematex.newSprite",
        "title": "SpritemateX: New Sprite File",
        "category": "SpritemateX"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "spritematex.newSprite"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^2.24.0",
    "typescript": "^5.4.0"
  }
}
